{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Firmware: testar ambos em host",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "RemoteSigned", "-File", "${workspaceFolder}/tools/test-host.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": "$gcc"
    },
    {
      "label": "Firmware: testar energia em host",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "RemoteSigned", "-File", "${workspaceFolder}/tools/test-host.ps1", "-App", "esp32-energy"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": "$gcc"
    },
    {
      "label": "Firmware: testar agua em host",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "RemoteSigned", "-File", "${workspaceFolder}/tools/test-host.ps1", "-App", "esp32-water"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": "$gcc"
    }
  ]
}
